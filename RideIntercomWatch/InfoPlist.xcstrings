{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your microphone sends your voice through your iPhone during a call."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話中にWatchのマイクで拾った声をiPhone経由で相手に届けます。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your iPhone to send and receive call audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話の音声を送受信するため、近くのiPhoneに接続します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
