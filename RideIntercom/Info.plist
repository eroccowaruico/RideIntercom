<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>RideIntercom Invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rideintercom</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_ride-intercom._tcp</string>
		<string>_ride-audio._udp</string>
	</array>
	<key>NSQuitAlwaysKeepsWindows</key>
	<false/>
	<key>StorageNamespace</key>
	<string>$(RIDEINTERCOM_STORAGE_NAMESPACE)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
