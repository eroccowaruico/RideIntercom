{
  "sourceLanguage": "en",
  "strings": {
    "Opus 24 and 32 kbps are lower-quality options. The default remains 48 kbps. Encoding bitrate is not total network usage.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Opusの24・32kbpsは音質低下を許容する選択肢です。既定は48kbpsのままです。符号化ビットレートは通信量全体を表しません。"
          }
        }
      }
    },
    "Set microphone mute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set microphone mute"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクのミュートを設定"
          }
        }
      }
    },
    "Should the microphone be muted?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should the microphone be muted?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクをミュートしますか？"
          }
        }
      }
    },
    "Set microphone mute to ${muted}": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set microphone mute to ${muted}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクのミュートを${muted}に設定"
          }
        }
      }
    },
    "Microphone muted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone muted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクをミュートしました。"
          }
        }
      }
    },
    "Microphone unmuted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone unmuted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクのミュートを解除しました。"
          }
        }
      }
    },
    "The microphone could not be changed. Open RideIntercom and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone could not be changed. Open RideIntercom and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクの状態を変更できませんでした。RideIntercomを開いて、もう一度お試しください。"
          }
        }
      }
    },
    "Call controls": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call controls"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話の操作"
          }
        }
      }
    },
    "%lld of 8 members including you": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分を含めて%lld人（上限8人）"
          }
        }
      }
    },
    "A device token is configured.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の接続設定は保存済みです。"
          }
        }
      }
    },
    "Access": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用権"
          }
        }
      }
    },
    "Access Status": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用権の状態"
          }
        }
      }
    },
    "Account": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        }
      }
    },
    "Account Data Deleted": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントデータを削除しました"
          }
        }
      }
    },
    "Account Deletion": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除"
          }
        }
      }
    },
    "Account deletion is still pending. Finish deletion on the device where you started it, then set up Internet calling again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除はまだ完了していません。削除を始めた端末で処理を終えてから、インターネット通話を設定し直してください。"
          }
        }
      }
    },
    "Add Saved Users": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みユーザーを追加"
          }
        }
      }
    },
    "Add Users": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーを追加"
          }
        }
      }
    },
    "Advanced": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細"
          }
        }
      }
    },
    "Advanced includes detailed call information and diagnostics. Switching layouts keeps your call connected.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細表示では通話の詳しい情報と診断を確認できます。表示を切り替えても通話は続きます。"
          }
        }
      }
    },
    "After signing in, you can use nearby calls without an Internet connection.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度ログインした後は、Internetにつながらない場所でも近距離通話を利用できます。"
          }
        }
      }
    },
    "An active pass is required to create a group or invite riders. Check Access in Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループの作成や招待には有効な利用権が必要です。設定の「利用権」を確認してください。"
          }
        }
      }
    },
    "An individual call has only two participants. Create a group to include more people.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個別通話の参加者は2人です。ほかの相手を含めるにはグループを作成してください。"
          }
        }
      }
    },
    "An unexpected participant joined this individual call. The call was stopped.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この個別通話に予定外の参加者が加わったため、通話を停止しました。"
          }
        }
      }
    },
    "App Layout": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面表示"
          }
        }
      }
    },
    "Apple authorization has not been removed. Open your Apple Account settings, choose Sign in with Apple, and remove RideIntercom.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの連携解除は完了していません。Appleアカウント設定の「Appleでサインイン」からRideIntercomを削除してください。"
          }
        }
      }
    },
    "Apple sign-in could not be checked. Your saved sign-in remains available.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleへのログイン状態を確認できませんでした。保存済みのログインは引き続き使えます。"
          }
        }
      }
    },
    "Apple sign-in could not be completed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleへのログインを完了できませんでした。"
          }
        }
      }
    },
    "Apple verification could not be prepared. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでの確認を準備できませんでした。接続を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "Audio": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声"
          }
        }
      }
    },
