      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用権を確認"
          }
        }
      }
    },
    "Check your headphones or speaker, then resume audio.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドホンやスピーカーを確認してから音声を再開してください。"
          }
        }
      }
    },
    "Checking Access": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用権を確認中"
          }
        }
      }
    },
    "Choose a Group": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを選ぶ"
          }
        }
      }
    },
    "Choose a User": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーを選ぶ"
          }
        }
      }
    },
    "Choose someone or a group to call.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話する相手かグループを選んでください。"
          }
        }
      }
    },
    "Choose the name you share with people in your groups. They can keep a different name for you on their own device.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループの相手に伝える名前を設定できます。相手は自分の端末内で別の呼び名を付けることもできます。"
          }
        }
      }
    },
    "Choose users who are not already in this group, up to 8 members including you.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだこのグループにいない相手を選んでください。自分を含めて8人まで参加できます。"
          }
        }
      }
    },
    "Close": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Configure Internet Connection": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット通話を設定"
          }
        }
      }
    },
    "Connect": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続"
          }
        }
      }
    },
    "Connect to a saved user or group in RideIntercom.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RideIntercomに保存したユーザーやグループへ接続します。"
          }
        }
      }
    },
    "Connect with Apple": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleで接続"
          }
        }
      }
    },
    "Connecting — waiting for others": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中・相手の参加を待っています"
          }
        }
      }
    },
    "Connection started. The other person must also join the call.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を開始しました。相手も通話に参加する必要があります。"
          }
        }
      }
    },
    "Continue Deletion": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を続ける"
          }
        }
      }
    },
    "Continue Without Apple Verification": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの確認なしで続ける"
          }
        }
      }
    },
    "Continue with the same Apple Account to also remove its authorization for RideIntercom.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じApple Accountで続けると、RideIntercomへの認可も取り消します。"
          }
        }
      }
    },
    "Copies on other devices and information already shared with friends remain. Purchases and subscriptions are not cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの端末のコピーや、友達に共有済みの情報は残ります。購入やサブスクリプションは取り消されません。"
          }
        }
      }
    },
    "Could Not Verify": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認できませんでした"
          }
        }
      }
    },
    "Could not create the group because the saved rider identity is invalid. Saved groups have not been changed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された本人情報を確認できないため、グループを作成できませんでした。保存済みのグループは変更していません。"
          }
        }
      }
    },
    "Could not finish the deletion record. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除の記録を完了できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "Could not read the group key. Try again.": {
      "extractionState": "manual",
