    "%@" : {
      "comment" : "The display representation of a call target. The first argument is the display name of the target. The second argument is the localized kind of the target.",
      "isCommentAutoGenerated" : true
    },
    "%@ / %@" : {
      "comment" : "Displays the connection and authentication status of a peer. The argument is the connection status, and the second argument is the authentication status.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "A combination of the package name and step title.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ Output" : {
      "comment" : "A slider that adjusts the volume of a remote participant's audio output.",
      "isCommentAutoGenerated" : true
    },
    "%@ Voice Isolation Effect" : {
      "comment" : "A toggle that enables or disables voice isolation for a given participant.",
      "isCommentAutoGenerated" : true
    },
