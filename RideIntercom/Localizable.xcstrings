          }
        }
      }
    },
    "This ends the current call and removes saved users, groups, and group keys. Unreadable data is preserved first. Your rider identity, audio settings, and Internet credentials stay unchanged. You will need new invitations." : {
      "extractionState" : "manual",
      "localizations" : {
