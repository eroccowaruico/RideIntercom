        }
      }
    },
    "Contact added. Confirmation can be resent." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手を追加しました。確認の通知を再送できます。"
          }
        }
      }
    },
    "This invitation was already accepted. Confirmation can be resent." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この招待は受け入れ済みです。確認の通知を再送できます。"
          }
        }
      }
    },
    "Invite someone, or accept an invitation to save each other." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手を招待するか、届いた招待を受け入れると、お互いを連絡先に保存できます。"
          }
        }
      }
    },
    "Contact saved. The acceptance notification was delivered." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
