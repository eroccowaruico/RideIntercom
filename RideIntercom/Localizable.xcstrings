      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RideComで私を連絡先に追加してください。"
          }
        }
      }
    },
    "Sharing does not register a person. Their acceptance will identify them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有だけでは相手は登録されません。相手が受け入れると、誰が受け入れたかを確認できます。"
