      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声チェック"
          }
        }
      }
    },
    "Audio I/O": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の入出力"
          }
        }
      }
    },
    "Audio check complete": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声チェックが完了しました"
          }
        }
      }
    },
    "Audio check idle": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を録音して再生できます"
          }
        }
      }
    },
    "Audio could not restart on the selected device. The group connection and relay continue. Check your device, then resume.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した機器で音声を再開できません。グループの接続と中継は続いています。機器を確認してから再開してください。"
          }
        }
      }
    },
    "Audio device changed. Run Audio Check again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声機器が変わりました。音声チェックをやり直してください。"
          }
        }
      }
    },
    "Audio device disconnected. Choose a device and run Audio Check again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声機器が切断されました。機器を選んで、音声チェックをやり直してください。"
          }
        }
      }
    },
    "Audio device disconnected. Your microphone and playback are paused; the group connection and relay continue. Check your audio device, then resume.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声機器が外れたため、マイクと再生を停止しています。グループの接続と中継は続いています。機器を確認してから音声を再開してください。"
          }
        }
      }
    },
