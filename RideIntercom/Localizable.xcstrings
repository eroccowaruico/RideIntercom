    "Stops retries on this device. A link already shared may still be accepted until it expires." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末での再試行を停止します。共有済みのリンクは、有効期限まで相手が受け入れられる場合があります。"
          }
        }
      }
    },
    "Accept Invitation" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待を受け入れる"
