// Xcode Test builds are isolated before the host initializes. Never include Debug.local.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG RIDEINTERCOM_VALIDATION
RIDEINTERCOM_STORAGE_NAMESPACE = RideIntercom.Validation.Xcode
RIDEINTERCOM_VALIDATION_SANDBOX = YES
RIDEINTERCOM_VALIDATION_SANDBOX[sdk=macosx*] = NO
RIDEINTERCOM_VALIDATION_ENTITLEMENTS =
